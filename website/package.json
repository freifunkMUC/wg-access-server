{
  "name": "wg-access-server-website",
  "type": "module",
  "scripts": {
    "codegen": "npx grpc-ts-web --format binary -o src/sdk ../proto/*.proto",
    "dev": "vite dev --port 3000",
    "start": "npm run dev",
    "build": "npx tsc && vite build",
    "preview": "vite preview --port 5000",
    "lint": "npx eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "test:watch": "vitest",
    "prettier": "npx prettier \"./src/**/*.{ts,tsx}\" --write"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "common-tags": "^1.8.2",
    "date-fns": "^4.4.0",
    "google-protobuf": "^4.0.2",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2",
    "numeral": "^2.0.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.3",
    "tweetnacl-ts": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@freifunkmuc/grpc-ts-web": "^0.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/common-tags": "^1.8.4",
    "@types/google-protobuf": "^3.15.12",
    "@types/numeral": "^2.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "grpc-web": "^2.1.1",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
